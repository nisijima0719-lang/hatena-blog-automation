name: Auto Blog Post

on:
  schedule:
    # 毎日9時、13時、18時（JST）に実行 → 2～3日に1回をローテーション
    - cron: '0 0 * * *'     # 毎日 09:00 JST
    - cron: '0 4 * * *'     # 毎日 13:00 JST
    - cron: '0 9 * * *'     # 毎日 18:00 JST
  workflow_dispatch:          # 手動実行も可能

jobs:
  post-blog:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        # 3つのキャラクターをローテーション
        character: ['kento', 'shota', 'misaki']
      max-parallel: 1  # 同時実行を避ける（1つずつ投稿）

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install anthropic requests

      - name: Generate and Post Article
        env:
          HATENA_ID: ${{ secrets.HATENA_ID }}
          HATENA_API_KEY: ${{ secrets.HATENA_API_KEY }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          cd scripts
          python generate_and_post.py ${{ matrix.character }}

      - name: Log execution time
        if: always()
        run: |
          echo "Posted at $(date)" >> $GITHUB_WORKSPACE/logs.txt

      - name: Notify on failure
        if: failure()
        run: |
          echo "❌ Blog post failed for ${{ matrix.character }}"
